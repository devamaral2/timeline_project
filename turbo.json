{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "BACKEND_URL",
    "API_SERVICE_URL",
    "API_PORT",
    "API_HOST",
    "DATABASE_URL",
    "AI_JOBS_CONCURRENCY",
    "AI_JOBS_LEASE_MS",
    "AI_JOBS_MAX_ATTEMPTS",
    "AI_JOBS_POLL_MS",
    "AI_AUTOMATION",
    "HERMES_URL",
    "HERMES_API_KEY",
    "AGENT_FILES_DIR",
    "AGENT_CONFIG_OWNER_USER_ID",
    "AUTH_SERVICE_URL",
    "AUTH_INTERNAL_SERVICE_KEY",
    "OPENROUTER_*",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "MCP_URL",
    "MCP_PORT",
    "MCP_TOKEN",
    "MCP_OWNER_USER_ID",
    "JEV_API_KEY",
    "WEB_PORT",
    "AUTH_PORT",
    "AUTH_HOST",
    "AUTH_DATABASE_URL",
    "AUTH_DATABASE_MIGRATION_URL",
    "AUTH_PUBLIC_URL",
    "AUTH_ISSUER",
    "AUTH_WEB_APP_URL",
    "AUTH_KEY_ENCRYPTION_KEY",
    "AUTH_PASSWORD_BLOCKLIST_TIMEOUT_MS",
    "AUTH_PASSWORD_EMAIL_LIMIT",
    "AUTH_PASSWORD_IP_LIMIT",
    "AUTH_PASSWORD_WINDOW_SECONDS",
    "AUTH_TEST_DATABASE_URL",
    "POSTGRES_HOST_PORT",
    "AUTH_POSTGRES_DB",
    "COMPOSE_PROJECT_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "app/build/outputs/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
