# --- app mobile (apps/mobile) ---
MOBILE_API_URL={{ op://lifecomposure/env.local/MOBILE_API_URL }}
MOBILE_AUTH_URL={{ op://lifecomposure/env.local/MOBILE_AUTH_URL }}

# --- backend (apps/api) ---
PORT={{ op://lifecomposure/env.local/PORT }}
API_HOST={{ op://lifecomposure/env.local/API_HOST }}
