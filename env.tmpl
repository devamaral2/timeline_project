# Gerado a partir de .env.example. Nao contem segredos, so referencias ao
# 1Password. Rode manualmente, uma vez por sessao de trabalho:
#   op inject -i env.tmpl -o .env.local
# Cofre: lifecomposure — item: env.local (Secure Note, um campo por variavel,
# label do campo = nome da env var).

# --- frontend (apps/web) ---

BACKEND_URL={{ op://lifecomposure/env.local/BACKEND_URL }}
AUTH_SERVICE_URL={{ op://lifecomposure/env.local/AUTH_SERVICE_URL }}
