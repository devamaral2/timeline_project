OPENROUTER_API_KEY=
JEV_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.5
BACKEND_URL=http://127.0.0.1:3002
# Em worktrees, o carregador deriva este valor de API_PORT no .env.local.
API_SERVICE_URL=http://127.0.0.1:3001
AUTH_SERVICE_URL=http://127.0.0.1:3002
AUTH_INTERNAL_SERVICE_KEY=
API_PORT=3001
API_HOST=127.0.0.1
WEB_PORT=3000
POSTGRES_USER=lifecomposure
POSTGRES_PASSWORD=
POSTGRES_DB=lifecomposure
POSTGRES_HOST_PORT=54391
DATABASE_URL=
# Banco da API: arquivo SQLite (ADR 0024). Sem valor, .data/api.sqlite na raiz do monorepo.
# API_DATABASE_PATH=
# Rota de IA por processo (ADR 003). O modelo cai em OPENROUTER_MODEL.
# OPENROUTER_PROCESS_MODEL=
# Raciocinio do fallback escolhido (`fallback: <pedido>`), mostrado na aba "Processo": off, low (padrao), medium
# ou high. Os outros agentes dessa rota nunca pensam.
# OPENROUTER_PROCESS_REASONING=low
# Rota do Hermes (ADR 004): off (padrao) ou on. Ligada, a API chama o Hermes em HERMES_URL com HERMES_API_KEY.
AI_AUTOMATION=off
# Pasta de skills e agentes do Hermes (ADR 0005), a mesma montada no container do Hermes. Sem valor, a API nao a le.
# Padrao: ~/.braid/agent-files (definido em scripts/onepassword/loader.mjs).
# AGENT_FILES_DIR=
# Id do usuario dono: so ele ve as notas de skills e agentes e pede edicoes. Veja `/api/me` ou a tabela de usuarios do Auth.
# AGENT_CONFIG_OWNER_USER_ID=
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Modo modelo do chat (ADR 0019): `/modelo`, `/claude`, `/openai` ou `/openrouter` no chat. Cada chave liga um
# provedor no seletor (o OpenRouter usa a OPENROUTER_API_KEY); sem nenhuma, o modo nao existe neste ambiente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Token do MCP da agenda (o mesmo do escopo mcp-runtime): com ele e com MCP_OWNER_USER_ID, o modelo le, cria e edita
# as entidades do dono. Sem ele, o modelo so conversa. MCP_URL padrao: http://127.0.0.1:<MCP_PORT>/mcp.
MCP_TOKEN=
# O dono que o MCP representa (o mesmo do escopo mcp-runtime): so ele usa o modo modelo com as ferramentas da agenda.
MCP_OWNER_USER_ID=
# MCP_URL=
NODE_ENV=development
AUTH_PORT=3002
AUTH_HOST=127.0.0.1
AUTH_DATABASE_URL=
AUTH_DATABASE_MIGRATION_URL=
AUTH_ISSUER=http://127.0.0.1:3002
AUTH_AUDIENCE=timeline-api
AUTH_PUBLIC_URL=http://127.0.0.1:3002
AUTH_WEB_APP_URL=http://localhost:3000
AUTH_KEY_ENCRYPTION_KEY=
AUTH_PASSWORD_BLOCKLIST_TIMEOUT_MS=2000
AUTH_PASSWORD_EMAIL_LIMIT=5
AUTH_PASSWORD_IP_LIMIT=30
AUTH_PASSWORD_WINDOW_SECONDS=900
ADMIN_PASSWORD=
AUTH_TEST_DATABASE_URL=
# Fila de jobs de IA: a tabela `jobs` da própria base (ADR 0013), sem broker.
AI_JOBS_CONCURRENCY=4
AI_JOBS_LEASE_MS=60000
AI_JOBS_MAX_ATTEMPTS=4
AI_JOBS_POLL_MS=500

# Derivadas automaticamente por scripts/worktree/provision-env.sh; não são
# exigidas no 1Password Environment.
# AUTH_POSTGRES_DB=

# Bootstrap do carregador 1Password (não são variáveis da aplicação).
# Mantenha ambos fora deste arquivo e fora do Git:
# OP_SERVICE_ACCOUNT_TOKEN=
# OP_ENVIRONMENT_ID=timeline-local
# Busca de locais do campo "Local" da tarefa (Photon sobre OpenStreetMap, sem chave). Troque para usar uma instancia propria.
# PLACES_SEARCH_URL=https://photon.komoot.io/api/
# Servico local de transcricao (apps/transcriber, spec #39), no computador de casa, escopo `transcriber-runtime`.
# O endereco publico do gateway (Auth) e a chave de dispositivo (`pnpm --filter @repo/auth run device-key -- issue`),
# que so serve em /api/transcription-worker/*. HF_TOKEN e o token do Hugging Face que o pyannote exige.
TRANSCRIBER_API_URL=
TRANSCRIBER_DEVICE_KEY=
HF_TOKEN=
