# --- frontend (apps/web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Onde o Next encontra o backend Nest. O rewrite de /api/* e o fetch server-side
# apontam para ca. O backend escuta so em loopback.
BACKEND_URL=http://127.0.0.1:3001

# --- app mobile (apps/mobile) ---
# Onde o app no celular encontra a API. Precisa ser o IP da sua maquina na rede
# local (nao 127.0.0.1 — o celular nao alcanca o loopback dela) ou o host de um
# deploy. As credenciais do Firebase sao as mesmas NEXT_PUBLIC_* acima.
MOBILE_API_URL=http://192.168.0.10:3001

# O OAuth client **web** do projeto Firebase, nao o Android nem o iOS: e ele que
# o Google Sign-In nativo usa para emitir o ID token que o Firebase aceita.
MOBILE_GOOGLE_WEB_CLIENT_ID=

# --- backend (apps/api) ---
PORT=3001

# Interface em que o Nest escuta. O padrao 127.0.0.1 mantem a API fora da rede,
# que e o comportamento de producao. Use 0.0.0.0 em desenvolvimento para o app
# mobile alcancar a API — nesse modo o CORS tambem e ligado.
API_HOST=127.0.0.1

# Credenciais do Firebase Admin. Sem elas, cai em applicationDefault().
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Modelo do agente de skills (/api/events/ai). Precisa suportar tool calling.
# Ex: anthropic/claude-sonnet-4.5, openai/gpt-4o-mini. Vazio = usa OPENROUTER_MODEL.
OPENROUTER_AGENT_MODEL=

# --- auth (apps/auth) ---
# O auth le somente estas variaveis. .env.local sobrescreve .env e o ambiente
# do processo sobrescreve os dois. Em producao mantenha as tres URLs de banco
# abaixo como credenciais distintas: runtime nao usa a URL de migracao.
NODE_ENV=development
AUTH_PORT=3002
AUTH_HOST=127.0.0.1
AUTH_DATABASE_URL=postgres://auth_runtime:change-me@127.0.0.1:5432/timeline_auth
AUTH_DATABASE_MIGRATION_URL=postgres://auth_migrator:change-me@127.0.0.1:5432/timeline_auth
# So o runner de testes pode definir esta URL (NODE_ENV=test).
AUTH_TEST_DATABASE_URL=postgres://auth_test:change-me@127.0.0.1:5432/timeline_auth_test
AUTH_ISSUER=http://127.0.0.1:3002
AUTH_AUDIENCE=timeline-api
AUTH_PUBLIC_URL=http://127.0.0.1:3002
AUTH_WEB_APP_URL=http://localhost:3000
# Gere uma KEK nova com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_KEY_ENCRYPTION_KEY=

# fake so e aceito em development/test, com AUTH_HOST de loopback e opt-in.
AUTH_OTP_PROVIDER=fake
AUTH_ALLOW_FAKE_OTP=true
AUTH_TWILIO_TIMEOUT_MS=5000
AUTH_TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

AUTH_PASSWORD_BLOCKLIST_TIMEOUT_MS=2000
AUTH_PASSWORD_EMAIL_LIMIT=5
AUTH_PASSWORD_IP_LIMIT=30
AUTH_PASSWORD_WINDOW_SECONDS=900
AUTH_MFA_SEND_LIMIT=3
AUTH_MFA_SEND_WINDOW_SECONDS=600
# A janela deste limite e a vida fixa de 600 segundos da tentativa.
AUTH_MFA_CHECK_LIMIT=5
