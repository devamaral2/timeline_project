{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@repo/contracts": ["../../packages/contracts/src/index.ts"],
      "@repo/contracts/youtube": ["../../packages/contracts/src/youtube.ts"],
      "@repo/theme": ["../../packages/theme/src/index.ts"],
      "@repo/timeline": ["../../packages/timeline/src/index.ts"],
      "@/*": ["../../apps/web/src/*"]
    }
  },
  "include": ["**/*", "../../apps/web/src/**/*", "../../packages/*/src/**/*"]
}
