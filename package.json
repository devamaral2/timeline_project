{
  "name": "braid-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "node scripts/onepassword/exec.mjs turbo run dev",
    "dev:auth": "node scripts/onepassword/exec.mjs turbo run dev --filter=@repo/auth",
    "dev:api": "node scripts/onepassword/exec.mjs turbo run dev --filter=@repo/api",
    "dev:web": "node scripts/onepassword/exec.mjs turbo run dev --filter=@repo/web",
    "dev:mobile": "node scripts/onepassword/exec.mjs pnpm --filter @repo/mobile run start",
    "secrets:check": "node scripts/onepassword/check.mjs",
    "secrets:check-one": "node scripts/onepassword/check-one.mjs",
    "secrets:exec": "node scripts/onepassword/exec.mjs",
    "build": "node scripts/onepassword/exec.mjs turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:ai": "cross-env VITE_CJS_IGNORE_WARNING=true vitest run --config vitest.quiet.config.ts",
    "test:postgres": "cross-env RUN_POSTGRES_INTEGRATION=1 VITE_CJS_IGNORE_WARNING=true vitest run --config vitest.quiet.config.ts --project api apps/api/src/infrastructure/persistence/integration/postgres.integration.test.ts",
    "db:generate": "pnpm --filter @repo/api run db:generate",
    "db:migrate": "pnpm --filter @repo/api run db:migrate",
    "compose:up": "docker compose -f infra/docker-compose.local.yml up -d",
    "compose:down": "docker compose -f infra/docker-compose.local.yml down",
    "bench:postgres": "cross-env RUN_POSTGRES_INTEGRATION=1 tsx apps/api/src/infrastructure/persistence/benchmarks/timeline.benchmark.ts",
    "worktree:new": "node scripts/onepassword/exec.mjs bash scripts/worktree/setup.sh",
    "worktree:provision": "node scripts/onepassword/exec.mjs bash scripts/worktree/provision-env.sh",
    "worktree:teardown": "node scripts/onepassword/exec.mjs bash scripts/worktree/teardown.sh"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.13",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
