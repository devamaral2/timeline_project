{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"extends": "//",
	"files": {
		"includes": ["**", "!**/*.svg"]
	},
	"linter": {
		"rules": {
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {},
						"patterns": [
							{
								"group": [
									"@repo/entities",
									"@repo/entities/*",
									"@repo/persistence",
									"@repo/persistence/*"
								],
								"message": "apps/mobile importa tipos de @repo/contracts; dominio e persistencia pertencem a apps/api."
							}
						]
					}
				}
			}
		}
	}
}
